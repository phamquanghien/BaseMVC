@{
    ViewData["Title"] = "Mật khẩu đã cập nhật";
}

<section class="card mx-auto w-full max-w-lg border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body items-center gap-5 p-6 text-center sm:p-8">
        <div class="badge badge-success badge-outline">Hoàn tất</div>
        <h1 class="text-3xl font-bold tracking-tight">Mật khẩu đã cập nhật</h1>
        <p class="text-base-content/70">Bạn có thể đăng nhập bằng mật khẩu mới.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
    </div>
</section>
