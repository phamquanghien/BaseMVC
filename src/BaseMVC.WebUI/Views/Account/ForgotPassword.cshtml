@model BaseMVC.WebUI.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="card mx-auto w-full max-w-md border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body gap-5 p-6 sm:p-8">
        <div>
            <div class="badge badge-primary badge-outline">Khôi phục tài khoản</div>
            <h1 class="mt-4 text-3xl font-bold tracking-tight">Quên mật khẩu?</h1>
            <p class="mt-2 text-base-content/70">Nhập email tài khoản để nhận liên kết đặt lại mật khẩu.</p>
        </div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" asp-antiforgery="false" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-error text-sm" role="alert"></div>

            <div class="form-control">
                <label asp-for="Email" class="label">
                    <span class="label-text font-medium">@Html.DisplayNameFor(model => model.Email)</span>
                </label>
                <input asp-for="Email" class="input input-bordered w-full" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="mt-1 text-sm text-error"></span>
            </div>

            <button type="submit" class="btn btn-primary w-full">Gửi liên kết khôi phục</button>
        </form>

        <a class="link link-hover self-center text-sm" asp-controller="Account" asp-action="Login">Quay lại đăng nhập</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
