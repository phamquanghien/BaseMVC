@{
    ViewData["Title"] = "Không đủ quyền truy cập";
}

<section class="hero min-h-[60vh]">
    <div class="hero-content w-full max-w-3xl px-0 text-center">
        <div class="card w-full border border-base-300 bg-base-100 shadow-xl">
            <div class="card-body items-center gap-5 px-6 py-10 sm:px-12 sm:py-14">
                <div class="grid size-20 place-items-center rounded-full bg-warning/15 text-warning">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 9v3m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3Z" />
                    </svg>
                </div>
                <div class="space-y-3">
                    <p class="badge badge-warning badge-outline font-semibold">LỖI 403</p>
                    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Bạn chưa có quyền truy cập</h1>
                    <p class="mx-auto max-w-xl text-base-content/70">
                        Tài khoản hiện tại đã đăng nhập nhưng chưa được cấp quyền sử dụng trang hoặc chức năng này.
                        Hãy liên hệ quản trị viên nếu bạn cần quyền truy cập.
                    </p>
                </div>
                <div class="mt-2 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
                    <a class="btn btn-outline" asp-controller="Account" asp-action="ChangePassword">Tài khoản của tôi</a>
                </div>
                <p class="text-xs text-base-content/50">Nếu quyền vừa được thay đổi, hãy thử tải lại trang.</p>
            </div>
        </div>
    </div>
</section>
