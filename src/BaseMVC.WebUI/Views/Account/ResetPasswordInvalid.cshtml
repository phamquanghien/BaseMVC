@{
    ViewData["Title"] = "Liên kết không hợp lệ";
}

<section class="card mx-auto w-full max-w-lg border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body items-center gap-5 p-6 text-center sm:p-8">
        <div class="badge badge-error badge-outline">Liên kết không hợp lệ</div>
        <h1 class="text-3xl font-bold tracking-tight">Không thể đặt lại mật khẩu</h1>
        <p class="text-base-content/70">Liên kết có thể đã hết hạn hoặc không hợp lệ. Hãy yêu cầu một liên kết mới.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="ForgotPassword">Yêu cầu liên kết mới</a>
    </div>
</section>
