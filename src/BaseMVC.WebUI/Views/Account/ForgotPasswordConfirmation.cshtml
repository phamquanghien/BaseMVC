@{
    ViewData["Title"] = "Kiểm tra email";
}

<section class="card mx-auto w-full max-w-lg border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body items-center gap-5 p-6 text-center sm:p-8">
        <div class="badge badge-success badge-outline">Yêu cầu đã được tiếp nhận</div>
        <h1 class="text-3xl font-bold tracking-tight">Kiểm tra email</h1>
        <p class="text-base-content/70">
            Nếu email khớp với tài khoản đã xác nhận, hệ thống sẽ gửi hướng dẫn khi dịch vụ email hoạt động.
            Nếu không nhận được email, vui lòng liên hệ quản trị viên.
        </p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Quay lại đăng nhập</a>
    </div>
</section>
