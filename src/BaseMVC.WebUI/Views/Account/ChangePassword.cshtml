@model BaseMVC.WebUI.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="card mx-auto w-full max-w-lg border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body gap-5 p-6 sm:p-8">
        <div>
            <div class="badge badge-primary badge-outline">Bảo mật tài khoản</div>
            <h1 class="mt-4 text-3xl font-bold tracking-tight">Đổi mật khẩu</h1>
            <p class="mt-2 text-base-content/70">Sử dụng mật khẩu mạnh và không chia sẻ với người khác.</p>
        </div>

        @if (ViewData["PasswordChanged"] is true)
        {
            <div class="alert alert-success" role="status">Mật khẩu đã được cập nhật thành công.</div>
        }

        <form asp-controller="Account" asp-action="ChangePassword" method="post" asp-antiforgery="false" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-error text-sm" role="alert"></div>

            <div class="form-control">
                <label asp-for="CurrentPassword" class="label">
                    <span class="label-text font-medium">@Html.DisplayNameFor(model => model.CurrentPassword)</span>
                </label>
                <input asp-for="CurrentPassword" class="input input-bordered w-full" autocomplete="current-password" autofocus />
                <span asp-validation-for="CurrentPassword" class="mt-1 text-sm text-error"></span>
            </div>

            <div class="form-control">
                <label asp-for="NewPassword" class="label">
                    <span class="label-text font-medium">@Html.DisplayNameFor(model => model.NewPassword)</span>
                </label>
                <input asp-for="NewPassword" class="input input-bordered w-full" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="mt-1 text-sm text-error"></span>
            </div>

            <div class="form-control">
                <label asp-for="ConfirmPassword" class="label">
                    <span class="label-text font-medium">@Html.DisplayNameFor(model => model.ConfirmPassword)</span>
                </label>
                <input asp-for="ConfirmPassword" class="input input-bordered w-full" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="mt-1 text-sm text-error"></span>
            </div>

            <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">Quay lại</a>
                <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
