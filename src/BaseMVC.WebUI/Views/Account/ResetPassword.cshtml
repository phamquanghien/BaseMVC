@model BaseMVC.WebUI.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="card mx-auto w-full max-w-lg border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body gap-5 p-6 sm:p-8">
        <div>
            <div class="badge badge-primary badge-outline">Khôi phục tài khoản</div>
            <h1 class="mt-4 text-3xl font-bold tracking-tight">Đặt lại mật khẩu</h1>
            <p class="mt-2 text-base-content/70">Liên kết chỉ sử dụng được một lần.</p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" asp-antiforgery="false" class="space-y-4">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Code" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-error text-sm" role="alert"></div>

            <div class="form-control">
                <label asp-for="Password" class="label">
                    <span class="label-text font-medium">@Html.DisplayNameFor(model => model.Password)</span>
                </label>
                <input asp-for="Password" class="input input-bordered w-full" autocomplete="new-password" autofocus />
                <span asp-validation-for="Password" class="mt-1 text-sm text-error"></span>
            </div>

            <div class="form-control">
                <label asp-for="ConfirmPassword" class="label">
                    <span class="label-text font-medium">@Html.DisplayNameFor(model => model.ConfirmPassword)</span>
                </label>
                <input asp-for="ConfirmPassword" class="input input-bordered w-full" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="mt-1 text-sm text-error"></span>
            </div>

            <button type="submit" class="btn btn-primary w-full">Cập nhật mật khẩu</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
