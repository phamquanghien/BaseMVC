@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Quản lý khoa";
    var canCreateFaculty = (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Faculties.Create")).Succeeded;
    var canUpdateFaculty = (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Faculties.Update")).Succeeded;
    var canDeleteFaculty = (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Faculties.Delete")).Succeeded;
}

<section class="space-y-6" data-faculty-manager
         data-search-url="@Url.Action("Search", "Faculties", new { area = "" })"
         data-create-url="@Url.Action("Create", "Faculties", new { area = "" })"
         data-edit-url-template="@Url.Action("Edit", "Faculties", new { area = "", id = 0 })"
         data-delete-url-template="@Url.Action("Delete", "Faculties", new { area = "", id = 0 })"
         data-can-create="@canCreateFaculty.ToString().ToLowerInvariant()"
         data-can-update="@canUpdateFaculty.ToString().ToLowerInvariant()"
         data-can-delete="@canDeleteFaculty.ToString().ToLowerInvariant()">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <div class="badge badge-primary badge-outline">Đào tạo</div>
            <h1 class="mt-3 text-3xl font-bold tracking-tight">Quản lý khoa</h1>
            <p class="mt-2 text-base-content/70">Tìm kiếm, phân trang và quản lý danh sách khoa.</p>
        </div>
        @if (canCreateFaculty)
        {
            <button type="button" class="btn btn-primary" data-faculty-create>
                <span aria-hidden="true">＋</span> Thêm khoa
            </button>
        }
    </div>

    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-5 p-4 sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <label class="input input-bordered flex w-full items-center gap-2 sm:max-w-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" stroke-width="2" />
                        <path stroke-linecap="round" stroke-width="2" d="m20 20-4-4" />
                    </svg>
                    <input type="search" class="grow" placeholder="Tìm theo mã hoặc tên khoa..." aria-label="Tìm theo mã hoặc tên khoa" data-faculty-search />
                </label>
                <label class="flex items-center gap-2 text-sm">
                    <span>Số dòng</span>
                    <select class="select select-bordered select-sm" aria-label="Số khoa mỗi trang" data-faculty-page-size>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </label>
            </div>

            <div class="alert alert-error hidden" role="alert" data-faculty-error></div>
            <div class="overflow-x-auto rounded-box border border-base-300">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mã khoa</th>
                            <th>Tên khoa</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody data-faculty-rows>
                        <tr><td colspan="3" class="py-10 text-center text-base-content/60">Đang tải danh sách khoa...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm text-base-content/70" aria-live="polite" data-faculty-count></p>
                <div class="join self-end" aria-label="Phân trang khoa">
                    <button type="button" class="btn btn-sm join-item" aria-label="Trang trước" data-faculty-previous>«</button>
                    <button type="button" class="btn btn-sm join-item no-animation" aria-live="polite" data-faculty-page-label>Trang 1 / 1</button>
                    <button type="button" class="btn btn-sm join-item" aria-label="Trang sau" data-faculty-next>»</button>
                </div>
            </div>
        </div>
    </div>

    <form id="faculty-antiforgery" asp-controller="Account" asp-action="Login" method="post" asp-antiforgery="false" class="hidden">
        @Html.AntiForgeryToken()
    </form>

    <dialog class="modal" data-faculty-modal>
        <div class="modal-box">
            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" aria-label="Đóng">✕</button>
            </form>
            <h2 class="text-xl font-bold" data-faculty-modal-title>Thêm khoa</h2>
            <p class="mt-2 text-sm text-base-content/70" data-faculty-modal-description>Nhập thông tin khoa mới.</p>
            <div class="alert alert-error mt-4 hidden" role="alert" data-faculty-modal-error></div>
            <div class="mt-5 space-y-4" data-faculty-fields>
                <div>
                    <label for="faculty-code" class="label"><span class="label-text font-medium">Mã khoa (2 ký tự)</span></label>
                    <input id="faculty-code" name="FacultyCode" type="text" class="input input-bordered w-full uppercase" minlength="2" maxlength="2" autocomplete="off" />
                </div>
                <div>
                    <label for="faculty-name" class="label"><span class="label-text font-medium">Tên khoa</span></label>
                    <input id="faculty-name" name="FacultyName" type="text" class="input input-bordered w-full" maxlength="200" autocomplete="off" />
                </div>
            </div>
            <div class="modal-action">
                <button type="button" class="btn btn-ghost" data-faculty-cancel>Hủy</button>
                <button type="button" class="btn btn-primary" data-faculty-submit>Lưu</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop"><button aria-label="Đóng hộp thoại">đóng</button></form>
    </dialog>
</section>

@section Scripts {
    <script src="~/js/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin-faculties.js" asp-append-version="true"></script>
}
