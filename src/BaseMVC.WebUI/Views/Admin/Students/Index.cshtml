@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Quản lý sinh viên";
    var canCreateStudent = (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Students.Create")).Succeeded;
    var canUpdateStudent = (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Students.Update")).Succeeded;
    var canDeleteStudent = (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Students.Delete")).Succeeded;
}

<section class="space-y-6" data-student-manager
         data-search-url="@Url.Action("Search", "Students", new { area = "" })"
         data-faculty-options-url="@Url.Action("FacultyOptions", "Students", new { area = "" })"
         data-create-url="@Url.Action("Create", "Students", new { area = "" })"
         data-import-url="@Url.Action("Import", "Students", new { area = "" })"
         data-edit-url-template="@Url.Action("Edit", "Students", new { area = "", id = 0 })"
         data-delete-url-template="@Url.Action("Delete", "Students", new { area = "", id = 0 })"
         data-can-create="@canCreateStudent.ToString().ToLowerInvariant()"
         data-can-update="@canUpdateStudent.ToString().ToLowerInvariant()"
         data-can-delete="@canDeleteStudent.ToString().ToLowerInvariant()">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <div class="badge badge-primary badge-outline">Đào tạo</div>
            <h1 class="mt-3 text-3xl font-bold tracking-tight">Quản lý sinh viên</h1>
            <p class="mt-2 text-base-content/70">Tìm kiếm, phân trang và quản lý danh sách sinh viên.</p>
        </div>
        @if (canCreateStudent)
        {
            <div class="flex gap-2">
                <button type="button" class="btn btn-outline" data-student-import>Import Excel</button>
                <button type="button" class="btn btn-primary" data-student-create>
                    <span aria-hidden="true">＋</span> Thêm sinh viên
                </button>
            </div>
        }
    </div>

    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-5 p-4 sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <label class="input input-bordered flex w-full items-center gap-2 sm:max-w-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" stroke-width="2" />
                        <path stroke-linecap="round" stroke-width="2" d="m20 20-4-4" />
                    </svg>
                    <input type="search" class="grow" placeholder="Tìm theo mã, họ tên, lớp hoặc khoa..." aria-label="Tìm sinh viên" data-student-search />
                </label>
                <label class="flex items-center gap-2 text-sm">
                    <span>Số dòng</span>
                    <select class="select select-bordered select-sm" aria-label="Số sinh viên mỗi trang" data-student-page-size>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </label>
            </div>

            <div class="alert alert-error hidden" role="alert" data-student-error></div>
            <div class="overflow-x-auto rounded-box border border-base-300">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mã SV</th>
                            <th>Họ và tên</th>
                            <th>Ngày sinh</th>
                            <th>Giới tính</th>
                            <th>Lớp</th>
                            <th>Khoa</th>
                            <th>Điều kiện</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody data-student-rows>
                        <tr><td colspan="8" class="py-10 text-center text-base-content/60">Đang tải danh sách sinh viên...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm text-base-content/70" aria-live="polite" data-student-count></p>
                <div class="join self-end" aria-label="Phân trang sinh viên">
                    <button type="button" class="btn btn-sm join-item" aria-label="Trang trước" data-student-previous>«</button>
                    <button type="button" class="btn btn-sm join-item no-animation" aria-live="polite" data-student-page-label>Trang 1 / 1</button>
                    <button type="button" class="btn btn-sm join-item" aria-label="Trang sau" data-student-next>»</button>
                </div>
            </div>
        </div>
    </div>

    <form id="student-antiforgery" asp-controller="Account" asp-action="Login" method="post" asp-antiforgery="false" class="hidden">
        @Html.AntiForgeryToken()
    </form>

    <dialog class="modal" data-student-modal>
        <div class="modal-box max-w-2xl">
            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" aria-label="Đóng">✕</button>
            </form>
            <h2 class="text-xl font-bold" data-student-modal-title>Thêm sinh viên</h2>
            <p class="mt-2 text-sm text-base-content/70" data-student-modal-description>Nhập thông tin sinh viên mới.</p>
            <div class="alert alert-error mt-4 hidden" role="alert" data-student-modal-error></div>
            <div class="mt-5 grid gap-4 sm:grid-cols-2" data-student-fields>
                <div>
                    <label for="student-code" class="label"><span class="label-text font-medium">Mã sinh viên (tối đa 15 ký tự: chữ, số, dấu -)</span></label>
                    <input id="student-code" type="text" class="input input-bordered w-full" maxlength="15" autocomplete="off" />
                </div>
                <div>
                    <label for="student-dob" class="label"><span class="label-text font-medium">Ngày sinh</span></label>
                    <input id="student-dob" type="date" class="input input-bordered w-full" />
                </div>
                <div>
                    <label for="student-last-name" class="label"><span class="label-text font-medium">Họ</span></label>
                    <input id="student-last-name" type="text" class="input input-bordered w-full" maxlength="100" autocomplete="off" />
                </div>
                <div>
                    <label for="student-first-name" class="label"><span class="label-text font-medium">Tên</span></label>
                    <input id="student-first-name" type="text" class="input input-bordered w-full" maxlength="100" autocomplete="off" />
                </div>
                <div>
                    <label for="student-class-code" class="label"><span class="label-text font-medium">Mã lớp</span></label>
                    <input id="student-class-code" type="text" class="input input-bordered w-full" maxlength="200" autocomplete="off" />
                </div>
                <div>
                    <label for="student-faculty" class="label"><span class="label-text font-medium">Khoa</span></label>
                    <select id="student-faculty" class="select select-bordered w-full"></select>
                </div>
                <div class="grid gap-2 sm:col-span-2 sm:grid-cols-2">
                    <label class="label cursor-pointer justify-start gap-3"><input id="student-gender" type="checkbox" class="checkbox checkbox-sm" /><span class="label-text">Giới tính Nam</span></label>
                    <label class="label cursor-pointer justify-start gap-3"><input id="student-english" type="checkbox" class="checkbox checkbox-sm" /><span class="label-text">Đủ điều kiện học tiếng Anh</span></label>
                    <label class="label cursor-pointer justify-start gap-3"><input id="student-language" type="checkbox" class="checkbox checkbox-sm" /><span class="label-text">Đạt chuẩn ngoại ngữ</span></label>
                    <label class="label cursor-pointer justify-start gap-3"><input id="student-it" type="checkbox" class="checkbox checkbox-sm" /><span class="label-text">Đạt chuẩn tin học</span></label>
                </div>
            </div>
            <div class="modal-action">
                <button type="button" class="btn btn-ghost" data-student-cancel>Hủy</button>
                <button type="button" class="btn btn-primary" data-student-submit>Lưu</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop"><button aria-label="Đóng hộp thoại">đóng</button></form>
    </dialog>

    @if (canCreateStudent)
    {
        <dialog class="modal" data-student-import-modal>
            <div class="modal-box max-w-2xl">
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" aria-label="Đóng">✕</button>
                </form>
                <h2 class="text-xl font-bold">Import sinh viên từ Excel</h2>
                <p class="mt-2 text-sm text-base-content/70">
                    File .xlsx (tối đa 5 MB, tối đa 10.000 dòng dữ liệu), dòng đầu là tiêu đề. Các cột theo thứ tự:
                    <span class="font-mono">StudentCode, LastName, FirstName, Gender (TRUE/FALSE hoặc 1/0), DateOfBirth (dd/mm/yyyy), ClassCode, FacultyCode</span>.
                    Dòng lỗi sẽ được bỏ qua và báo cáo; dòng hợp lệ vẫn được lưu.
                </p>
                <div class="alert alert-error mt-4 hidden" role="alert" data-student-import-error></div>
                <input type="file" accept=".xlsx" class="file-input file-input-bordered mt-4 w-full" aria-label="Chọn file Excel" data-student-import-file />
                <div class="alert alert-info mt-4 hidden" role="status" data-student-import-summary></div>
                <ul class="mt-3 max-h-60 list-disc space-y-1 overflow-y-auto pl-5 text-sm text-error" data-student-import-errors></ul>
                <div class="modal-action">
                    <button type="button" class="btn btn-ghost" data-student-import-close>Đóng</button>
                    <button type="button" class="btn btn-primary" data-student-import-submit>Import</button>
                </div>
            </div>
            <form method="dialog" class="modal-backdrop"><button aria-label="Đóng hộp thoại">đóng</button></form>
        </dialog>
    }
</section>

@section Scripts {
    <script src="~/js/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin-students.js" asp-append-version="true"></script>
}
