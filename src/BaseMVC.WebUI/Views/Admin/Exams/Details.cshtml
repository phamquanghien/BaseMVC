@model int
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Chi tiết kỳ thi";
    var canImport = (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Exams.Update")).Succeeded;
    var canChangeStatus = (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Exams.ChangeStatus")).Succeeded;
}

<section class="space-y-6" data-exam-details
         data-summary-url="@Url.Action("Summary", "Exams", new { area = "", id = Model })"
         data-candidates-url="@Url.Action("ItCandidates", "Exams", new { area = "", id = Model })"
         data-results-url="@Url.Action("ItResults", "Exams", new { area = "", id = Model })"
         data-import-url="@Url.Action("Import", "Exams", new { area = "", id = Model })"
         data-status-url="@Url.Action("ChangeStatus", "Exams", new { area = "", id = Model })"
         data-template-url="@Url.Action("ImportTemplate", "Exams", new { area = "" })"
         data-can-import="@canImport.ToString().ToLowerInvariant()"
         data-can-change-status="@canChangeStatus.ToString().ToLowerInvariant()">
    <div>
        <a class="link link-primary text-sm" href="@Url.Action("Index", "Exams", new { area = "" })">← Danh sách kỳ thi</a>
        <h1 class="mt-3 text-3xl font-bold tracking-tight" data-details-name>Đang tải...</h1>
        <p class="mt-2 flex flex-wrap items-center gap-2 text-base-content/70">
            <span data-details-type></span>
            <span class="badge badge-outline whitespace-nowrap" data-details-status></span>
        </p>
    </div>

    <div class="alert alert-error hidden" role="alert" data-details-error></div>

    @if (canChangeStatus)
    {
        <div class="card border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body gap-3 p-4 sm:p-6">
                <h2 class="text-lg font-semibold">Chuyển trạng thái kỳ thi</h2>
                <p class="text-xs text-base-content/60">Dùng để mở lại hoặc sửa trạng thái khi có nhầm lẫn; có thể chuyển sang bất kỳ trạng thái nào.</p>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                    <select class="select select-bordered w-full sm:max-w-xs" aria-label="Trạng thái kỳ thi" data-status-select>
                        <option value="NotStarted">Chưa bắt đầu</option>
                        <option value="RegistrationOpen">Mở đăng ký</option>
                        <option value="RegistrationCompleted">Đã hoàn thành đăng ký</option>
                        <option value="AwaitingSchedule">Chờ xếp lịch thi</option>
                        <option value="ScheduleArranged">Đã xếp lịch thi</option>
                        <option value="Taken">Đã thi (Chờ kết quả)</option>
                        <option value="ResultsEntered">Đã nhập kết quả</option>
                        <option value="Completed">Hoàn thành</option>
                    </select>
                    <button type="button" class="btn btn-primary" data-status-submit>Chuyển trạng thái</button>
                </div>
                <div class="alert alert-error hidden" role="alert" data-status-error></div>
            </div>
        </div>
    }

    @if (canImport)
    {
        <div class="card border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body gap-4 p-4 sm:p-6">
                <h2 class="text-lg font-semibold">Nhập dữ liệu từ Excel</h2>
                <div class="grid gap-3 sm:grid-cols-3">
                    <label class="form-control">
                        <span class="label-text mb-1 font-medium">Định dạng file</span>
                        <select class="select select-bordered w-full" data-import-format>
                            <option value="ItStandard">Chuẩn đầu ra CNTT</option>
                        </select>
                    </label>
                    <label class="form-control">
                        <span class="label-text mb-1 font-medium">Dữ liệu</span>
                        <select class="select select-bordered w-full" data-import-kind>
                            <option value="Candidates">Danh sách thi</option>
                            <option value="Results">Kết quả thi</option>
                        </select>
                    </label>
                    <label class="form-control">
                        <span class="label-text mb-1 font-medium">Nếu đã có dữ liệu</span>
                        <select class="select select-bordered w-full" data-import-mode>
                            <option value="ReplaceAll">Thay thế toàn bộ dữ liệu cũ</option>
                            <option value="AddOnly">Chỉ thêm mới, bỏ qua dòng trùng</option>
                        </select>
                    </label>
                </div>
                <p class="text-xs text-base-content/60" data-import-hint></p>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                    <input type="file" accept=".xlsx" class="file-input file-input-bordered w-full sm:max-w-md" aria-label="Chọn file Excel" data-import-file />
                    <button type="button" class="btn btn-primary" data-import-submit>Import</button>
                    <a class="link link-primary text-sm" href="#" data-import-template>Tải file mẫu</a>
                </div>
                <div class="alert alert-error hidden" role="alert" data-import-error></div>
                <div class="alert alert-info hidden" role="status" data-import-summary></div>
                <ul class="max-h-60 list-disc space-y-1 overflow-y-auto pl-5 text-sm text-error" data-import-errors></ul>
            </div>
        </div>
    }

    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4 p-4 sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <h2 class="text-lg font-semibold">Danh sách thi <span class="text-sm font-normal text-base-content/60" data-candidates-total></span></h2>
                <input type="search" class="input input-bordered w-full sm:w-72" placeholder="Tìm theo mã, họ, tên..." aria-label="Tìm trong danh sách thi" data-candidates-search />
            </div>
            <div class="overflow-x-auto rounded-box border border-base-300">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Mã SV</th><th>Họ lót</th><th>Tên</th><th>Ngày thi</th><th>Ca thi</th><th>Giờ thi</th><th>Phòng thi</th><th>Kỳ bảo lưu</th><th>Phần bảo lưu</th></tr>
                    </thead>
                    <tbody data-candidates-rows>
                        <tr><td colspan="10" class="py-8 text-center text-base-content/60">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="join self-end" aria-label="Phân trang danh sách thi">
                <button type="button" class="btn btn-sm join-item" aria-label="Trang trước" data-candidates-previous>«</button>
                <button type="button" class="btn btn-sm join-item no-animation" aria-live="polite" data-candidates-page>Trang 1 / 1</button>
                <button type="button" class="btn btn-sm join-item" aria-label="Trang sau" data-candidates-next>»</button>
            </div>
        </div>
    </div>

    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4 p-4 sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <h2 class="text-lg font-semibold">Kết quả thi <span class="text-sm font-normal text-base-content/60" data-results-total></span></h2>
                <input type="search" class="input input-bordered w-full sm:w-72" placeholder="Tìm theo mã, họ, tên..." aria-label="Tìm trong kết quả thi" data-results-search />
            </div>
            <div class="overflow-x-auto rounded-box border border-base-300">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Mã SV</th><th>Họ lót</th><th>Tên</th><th>Điểm trắc nghiệm</th><th>Điểm thực hành</th><th>Tổng điểm</th><th>Ghi chú</th></tr>
                    </thead>
                    <tbody data-results-rows>
                        <tr><td colspan="8" class="py-8 text-center text-base-content/60">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="join self-end" aria-label="Phân trang kết quả thi">
                <button type="button" class="btn btn-sm join-item" aria-label="Trang trước" data-results-previous>«</button>
                <button type="button" class="btn btn-sm join-item no-animation" aria-live="polite" data-results-page>Trang 1 / 1</button>
                <button type="button" class="btn btn-sm join-item" aria-label="Trang sau" data-results-next>»</button>
            </div>
        </div>
    </div>

    <form id="exam-details-antiforgery" asp-controller="Account" asp-action="Login" method="post" asp-antiforgery="false" class="hidden">
        @Html.AntiForgeryToken()
    </form>
</section>

@section Scripts {
    <script src="~/js/admin-common.js" asp-append-version="true"></script>
    <script src="~/js/admin-exam-details.js" asp-append-version="true"></script>
}
