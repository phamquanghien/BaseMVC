@model BaseMVC.WebUI.Models.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "HỆ THỐNG TRA CỨU KẾT QUẢ THI CFI - HUMG";
}

<section class="lookup-page relative isolate -mx-4 -my-10 min-h-full overflow-hidden px-4 py-10 sm:-mx-6 sm:px-6 sm:py-14 lg:-mx-8 lg:px-8" data-public-exam-lookup
         data-types-url="@Url.Action("ExamTypes", "Home")"
         data-lookup-url="@Url.Action("Lookup", "Home")"
         data-site-key="@Model.RecaptchaSiteKey">
    <div class="lookup-orb lookup-orb-one" aria-hidden="true"></div>
    <div class="lookup-orb lookup-orb-two" aria-hidden="true"></div>
    <div class="lookup-content mx-auto max-w-5xl space-y-8">
    <header class="lookup-header text-center">
        <div class="lookup-brand-mark" aria-hidden="true">CFI</div>
        <h1 class="lookup-title mt-4 text-3xl font-bold tracking-tight sm:text-4xl">HỆ THỐNG TRA CỨU KẾT QUẢ THI CFI - HUMG</h1>
        <p class="mx-auto mt-4 max-w-2xl text-base-content/70">Tra cứu lịch thi hoặc kết quả thi bằng mã sinh viên và ngày sinh.</p>
    </header>

    <aside class="lookup-glass lookup-guide" aria-labelledby="lookup-guide-title">
        <div class="lookup-section-heading">
            <span class="lookup-heading-icon" aria-hidden="true">i</span>
            <h2 id="lookup-guide-title" class="text-lg font-semibold">Hướng dẫn tra cứu</h2>
        </div>
        <ol class="lookup-steps">
                <li><span class="lookup-step-number">01</span><span>Chọn thông tin tra cứu <strong>Kết quả thi</strong> hoặc <strong>Lịch thi</strong>.</span></li>
                <li><span class="lookup-step-number">02</span><span>Chọn <strong>loại kỳ thi muốn tra cứu kết quả</strong>.</span></li>
                <li><span class="lookup-step-number">03</span><span>Nhập các thông tin theo yêu cầu.</span></li>
                <li><span class="lookup-step-number">04</span><span>Nhấn <strong>Tra cứu</strong> để xem kết quả.</span></li>
            </ol>
    </aside>

    <div class="lookup-glass lookup-form-panel">
        <div class="lookup-form-heading">
            <div>
                <p class="lookup-eyebrow">Cổng tra cứu sinh viên</p>
                <h2 class="mt-1 text-xl font-semibold">Thông tin tra cứu</h2>
            </div>
            <span class="lookup-shield" aria-hidden="true">✓</span>
        </div>
        <div class="lookup-form-body">
            <div class="grid gap-4 sm:grid-cols-2">
                <label class="form-control">
                    <span class="label-text mb-1 font-medium">Bạn muốn tra cứu</span>
                    <select class="select select-bordered w-full" data-lookup-kind required>
                        <option value="">Chọn lịch thi hoặc kết quả thi</option>
                        <option value="Schedule">Lịch thi</option>
                        <option value="Results">Kết quả thi</option>
                    </select>
                </label>
                <label class="form-control hidden" data-exam-type-field>
                    <span class="label-text mb-1 font-medium">Loại kỳ thi</span>
                    <select class="select select-bordered w-full" data-exam-type required disabled>
                        <option value="">Chọn loại kỳ thi</option>
                    </select>
                </label>
            </div>

            <div class="alert alert-error hidden" role="alert" data-lookup-error></div>
            <div class="alert alert-info hidden" role="status" data-lookup-message></div>

            <form class="hidden space-y-4" data-lookup-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Kind" data-hidden-kind />
                <input type="hidden" name="ExamTypeId" data-hidden-exam-type />
                <input type="hidden" name="RecaptchaToken" data-recaptcha-token />
                <div class="grid gap-4 sm:grid-cols-2">
                    <label class="form-control">
                        <span class="label-text mb-1 font-medium" data-identifier-label>Mã sinh viên</span>
                        <input class="input input-bordered w-full" name="Identifier" maxlength="50" required />
                    </label>
                    <label class="form-control">
                        <span class="label-text mb-1 font-medium">Ngày tháng năm sinh</span>
                        <input class="input input-bordered w-full" type="text" name="DateOfBirth" placeholder="dd/mm/yyyy" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" autocomplete="bday" required data-date-input />
                    </label>
                </div>
                @if (string.IsNullOrWhiteSpace(Model.RecaptchaSiteKey))
                {
                    <p class="text-sm text-warning">Chức năng tra cứu chưa được cấu hình reCAPTCHA.</p>
                }
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                    <button type="submit" class="btn btn-primary sm:min-w-40" data-lookup-submit disabled="@(string.IsNullOrWhiteSpace(Model.RecaptchaSiteKey))">Tra cứu</button>
                </div>
            </form>
        </div>
    </div>

    <section class="lookup-glass lookup-results hidden" aria-live="polite" data-lookup-results>
        <div class="lookup-results-heading">
            <h2 class="text-xl font-semibold">Thông tin tra cứu</h2>
            <span class="lookup-results-status"><span></span> Đã tìm thấy</span>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-white/70 bg-white/50">
            <table class="table table-sm">
                <thead><tr data-lookup-results-head></tr></thead>
                <tbody data-lookup-results-rows></tbody>
            </table>
        </div>
    </section>
    </div>
</section>

@section Scripts {
    @if (!string.IsNullOrWhiteSpace(Model.RecaptchaSiteKey))
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@Model.RecaptchaSiteKey" async defer></script>
    }
    <script src="~/js/public-exam-lookup.js" asp-append-version="true"></script>
    <script>
        // Auto-format date input to dd/mm/yyyy
        document.addEventListener('DOMContentLoaded', function () {
            const dateInput = document.querySelector('[data-date-input]');
            if (dateInput) {
                dateInput.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, ''); // Remove all non-digit characters
                    
                    if (value.length > 8) {
                        value = value.slice(0, 8);
                    }
                    
                    let formatted = '';
                    for (let i = 0; i < value.length; i++) {
                        if (i === 2 || i === 4) {
                            formatted += '/';
                        }
                        formatted += value[i];
                    }
                    
                    e.target.value = formatted;
                });
            }
        });
    </script>
}

