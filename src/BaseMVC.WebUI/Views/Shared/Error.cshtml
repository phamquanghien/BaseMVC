@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="alert alert-error mx-auto max-w-3xl items-start">
    <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 size-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3Z" />
    </svg>
    <div>
        <h1 class="text-xl font-bold">Đã xảy ra lỗi</h1>
        <p>Yêu cầu không thể được xử lý. Vui lòng thử lại sau.</p>
        @if (Model.ShowRequestId)
        {
            <p class="mt-2 text-sm">Mã yêu cầu: <code class="rounded bg-base-100/50 px-1 py-0.5">@Model.RequestId</code></p>
        }
    </div>
</section>
