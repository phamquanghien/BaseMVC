@using static BaseMVC.WebUI.Navigation.NavUi
@if (User.Identity?.IsAuthenticated == true)
{
    var accountName = User.Identity.Name ?? "?";
    var initial = char.ToUpperInvariant(accountName[0]);
    <details class="dropdown dropdown-end" data-nav-dropdown>
        <summary class="btn btn-ghost btn-circle avatar list-none" aria-label="Tài khoản" title="@accountName">
            <span class="grid size-9 place-items-center rounded-full bg-gradient-to-br from-primary to-secondary font-semibold text-primary-content ring-2 ring-primary/20">@initial</span>
        </summary>
        <div class="dropdown-content z-50 mt-3 w-72 overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-xl">
            <div class="flex items-center gap-3 bg-base-200/70 px-4 py-3">
                <span class="grid size-10 shrink-0 place-items-center rounded-full bg-gradient-to-br from-primary to-secondary font-semibold text-primary-content">@initial</span>
                <div class="min-w-0">
                    <p class="text-xs text-base-content/60">Đang đăng nhập</p>
                    <p class="truncate text-sm font-semibold" title="@accountName">@accountName</p>
                </div>
            </div>
            <ul class="menu w-full p-2">
                <li><a asp-area="" asp-controller="Account" asp-action="ChangePassword">@Icon("password") Đổi mật khẩu</a></li>
                <li>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="false" class="p-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="flex w-full items-center gap-2 px-3 py-2 text-error">@Icon("logout") Đăng xuất</button>
                    </form>
                </li>
            </ul>
        </div>
    </details>
}
else
{
    <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
}
