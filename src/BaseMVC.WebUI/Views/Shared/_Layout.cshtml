        ["chevron"] = "m19.5 8.25-7.5 7.5-7.5-7.5",
        ["menu"] = "M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5",
        ["close"] = "M6 18 18 6M6 6l12 12"
    };

    private Microsoft.AspNetCore.Html.IHtmlContent Icon(string name, string cssClass = "size-4") =>
        new Microsoft.AspNetCore.Html.HtmlString(
            $"<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"{cssClass} shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{NavIcons[name]}\" /></svg>");

    private string CurrentController => ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    private bool IsActive(params string[] controllers) =>
        controllers.Any(controller => string.Equals(controller, CurrentController, StringComparison.OrdinalIgnoreCase));
}
<html lang="vi" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>@ViewData["Title"] - BaseMVC</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="min-h-screen bg-base-200 text-base-content">
    <div class="flex min-h-screen flex-col">
        <header class="sticky top-0 z-20 border-b border-base-300 bg-base-100/90 shadow-sm backdrop-blur">
            <div class="h-0.5 bg-gradient-to-r from-primary via-secondary to-accent" aria-hidden="true"></div>
            <nav class="navbar mx-auto w-full max-w-7xl gap-2 px-4 sm:px-6 lg:px-8" aria-label="Điều hướng chính">
                <div class="navbar-start w-auto flex-1">
                    <a class="btn btn-ghost gap-2 px-2 text-lg font-bold tracking-tight" asp-area=""
                       asp-controller="Home" asp-action="Index" aria-label="BaseMVC - Trang chủ">
                        <span class="grid size-9 place-items-center rounded-xl bg-gradient-to-br from-primary to-secondary text-primary-content shadow-sm">B</span>
                        <span>BaseMVC</span>
                    </a>
                </div>
                <div class="navbar-end w-auto gap-1 sm:gap-2">
                    <ul class="menu menu-horizontal hidden items-center gap-1 px-1 md:flex">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" class="@(homeActive ? "menu-active" : "")">@Icon("home") Trang chủ</a></li>
                        @if (showSystemMenu)
                        {
                            <li class="dropdown dropdown-hover">
                                <div tabindex="0" role="button" aria-haspopup="true" class="@(systemActive ? "menu-active" : "")">@Icon("system") Hệ thống @Icon("chevron", "size-3")</div>
                                <ul tabindex="0" class="menu dropdown-content z-50 mt-0 w-52 gap-1 rounded-box border border-base-300 bg-base-100 p-2 shadow-xl">
                                    @if (canReadRoles)
                                    {
                                        <li><a asp-controller="Roles" asp-action="Index" class="@(IsActive("Roles") ? "menu-active" : "")">@Icon("roles") Vai trò</a></li>
                                    }
                                    @if (canReadPermissions)
                                    {
                                        <li><a asp-controller="Permissions" asp-action="Index" class="@(IsActive("Permissions") ? "menu-active" : "")">@Icon("permissions") Phân quyền</a></li>
                                    }
                                    @if (canReadUsers)
                                    {
                                        <li><a asp-controller="Users" asp-action="Index" class="@(IsActive("Users") ? "menu-active" : "")">@Icon("users") Người dùng</a></li>
                                    }
                                    @if (canReadAudit)
                                    {
                                        <li><a asp-controller="Audit" asp-action="Index" class="@(IsActive("Audit") ? "menu-active" : "")">@Icon("audit") Nhật ký</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (showDataMenu)
                        {
                            <li class="dropdown dropdown-hover">
                                <div tabindex="0" role="button" aria-haspopup="true" class="@(dataActive ? "menu-active" : "")">@Icon("data") Dữ liệu @Icon("chevron", "size-3")</div>
                                <ul tabindex="0" class="menu dropdown-content z-50 mt-0 w-52 gap-1 rounded-box border border-base-300 bg-base-100 p-2 shadow-xl">
                                    @if (canReadFaculties)
                                    {
                                        <li><a asp-controller="Faculties" asp-action="Index" class="@(IsActive("Faculties") ? "menu-active" : "")">@Icon("faculties") Khoa</a></li>
                                    }
                                    @if (canReadStudents)
                                    {
                                        <li><a asp-controller="Students" asp-action="Index" class="@(IsActive("Students") ? "menu-active" : "")">@Icon("students") Sinh viên</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var accountName = User.Identity.Name ?? "?";
                        var initial = char.ToUpperInvariant(accountName[0]);
                        <details class="dropdown dropdown-end" data-nav-dropdown>
                            <summary class="btn btn-ghost btn-circle avatar list-none" aria-label="Tài khoản" title="@accountName">
                                <span class="grid size-9 place-items-center rounded-full bg-gradient-to-br from-primary to-secondary font-semibold text-primary-content ring-2 ring-primary/20">@initial</span>
                            </summary>
                            <div class="dropdown-content z-50 mt-3 w-72 overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-xl">
                                <div class="flex items-center gap-3 bg-base-200/70 px-4 py-3">
                                    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-gradient-to-br from-primary to-secondary font-semibold text-primary-content">@initial</span>
                                    <div class="min-w-0">
                                        <p class="text-xs text-base-content/60">Đang đăng nhập</p>
                                        <p class="truncate text-sm font-semibold" title="@accountName">@accountName</p>
                                    </div>
                                </div>
                                <ul class="menu w-full p-2">
                                    <li><a asp-controller="Account" asp-action="ChangePassword">@Icon("password") Đổi mật khẩu</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="false" class="p-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="/" />
                                            <button type="submit" class="flex w-full items-center gap-2 px-3 py-2 text-error">@Icon("logout") Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </details>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    }
                    <details class="dropdown dropdown-end md:hidden" data-nav-dropdown>
                        <summary class="btn btn-ghost btn-square list-none" aria-label="Mở hoặc đóng menu">
                            <span data-nav-icon-open>@Icon("menu", "size-6")</span>
                            <span class="hidden" data-nav-icon-close>@Icon("close", "size-6")</span>
                        </summary>
                        <div class="dropdown-content z-50 mt-3 w-[min(20rem,calc(100vw-2rem))] max-h-[70vh] overflow-y-auto rounded-box border border-base-300 bg-base-100 p-2 shadow-xl">
                            <ul class="menu w-full gap-1 p-0">
                                <li><a asp-area="" asp-controller="Home" asp-action="Index" class="@(homeActive ? "menu-active" : "")">@Icon("home") Trang chủ</a></li>
                            @if (showSystemMenu)
                            {
                                <li>
                                    <details open>
                                        <summary class="font-semibold">@Icon("system") Hệ thống</summary>
                                        <ul>
                                            @if (canReadRoles)
                                            {
                                                <li><a asp-controller="Roles" asp-action="Index" class="@(IsActive("Roles") ? "menu-active" : "")">@Icon("roles") Vai trò</a></li>
                                            }
                                            @if (canReadPermissions)
                                            {
                                                <li><a asp-controller="Permissions" asp-action="Index" class="@(IsActive("Permissions") ? "menu-active" : "")">@Icon("permissions") Phân quyền</a></li>
                                            }
                                            @if (canReadUsers)
                                            {
                                                <li><a asp-controller="Users" asp-action="Index" class="@(IsActive("Users") ? "menu-active" : "")">@Icon("users") Người dùng</a></li>
                                            }
                                            @if (canReadAudit)
                                            {
                                                <li><a asp-controller="Audit" asp-action="Index" class="@(IsActive("Audit") ? "menu-active" : "")">@Icon("audit") Nhật ký</a></li>
                                            }
                                        </ul>
                                    </details>
                                </li>
                            }
                            @if (showDataMenu)
                            {
                                <li>
                                    <details open>
                                        <summary class="font-semibold">@Icon("data") Dữ liệu</summary>
                                        <ul>
                                            @if (canReadFaculties)
                                            {
                                                <li><a asp-controller="Faculties" asp-action="Index" class="@(IsActive("Faculties") ? "menu-active" : "")">@Icon("faculties") Khoa</a></li>
                                            }
                                            @if (canReadStudents)
                                            {
                                                <li><a asp-controller="Students" asp-action="Index" class="@(IsActive("Students") ? "menu-active" : "")">@Icon("students") Sinh viên</a></li>
                                            }
                                        </ul>
                                    </details>
                                </li>
                            }
                            </ul>
                        </div>
                    </details>
                </div>
            </nav>
        </header>

        <main id="main-content" class="mx-auto w-full max-w-7xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
            @RenderBody()
        </main>

        <footer class="border-t border-base-300 bg-base-100">
            <div
                class="mx-auto flex w-full max-w-7xl flex-col gap-2 px-4 py-6 text-sm text-base-content/70 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
                <p>&copy; @DateTime.Now.Year BaseMVC. Nền tảng khởi đầu cho ứng dụng của bạn.</p>
                <a class="link link-hover" asp-area="" asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
