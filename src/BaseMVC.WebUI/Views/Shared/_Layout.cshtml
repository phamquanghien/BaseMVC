<!DOCTYPE html>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    var canReadRoles = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Roles.Read")).Succeeded;
    var canReadPermissions = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Access.Read")).Succeeded;
    var canReadAudit = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Audit.Read")).Succeeded;
    var canReadUsers = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Users.Read")).Succeeded;
    var canReadFaculties = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Faculties.Read")).Succeeded;
    var canReadStudents = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Students.Read")).Succeeded;
    var showSystemMenu = canReadRoles || canReadPermissions || canReadUsers || canReadAudit;
    var showDataMenu = canReadFaculties || canReadStudents;
    var systemActive = IsActive("Roles", "Permissions", "Users", "Audit");
    var dataActive = IsActive("Faculties", "Students");
    var homeActive = IsActive("Home");
}
