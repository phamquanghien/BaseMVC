<!DOCTYPE html>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    var canReadRoles = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Roles.Read")).Succeeded;
    var canReadPermissions = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Access.Read")).Succeeded;
    var canReadUsers = User.Identity?.IsAuthenticated == true
        && (await AuthorizationService.AuthorizeAsync(User, resource: null, "Permissions.Users.Read")).Succeeded;
}
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>@ViewData["Title"] - BaseMVC</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-base-200 text-base-content">
    <div class="flex min-h-screen flex-col">
        <header class="sticky top-0 z-20 border-b border-base-300 bg-base-100/95 shadow-sm backdrop-blur">
            <nav class="navbar mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8" aria-label="Điều hướng chính">
                <div class="navbar-start">
                    <a class="btn btn-ghost gap-2 px-2 text-lg font-bold tracking-tight" asp-area="" asp-controller="Home" asp-action="Index" aria-label="BaseMVC - Trang chủ">
                        <span class="grid size-9 place-items-center rounded-xl bg-primary text-primary-content">B</span>
                        <span>BaseMVC</span>
                    </a>
                </div>
                <div class="navbar-center hidden md:flex">
                    <ul class="menu menu-horizontal gap-1 px-1">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a></li>
                        @if (canReadRoles)
                        {
                            <li><a asp-controller="Roles" asp-action="Index">Vai trò</a></li>
                        }
                        @if (canReadUsers)
                        {
                            <li><a asp-controller="Users" asp-action="Index">Người dùng</a></li>
                        }
                        @if (canReadPermissions)
                        {
                            <li><a asp-controller="Permissions" asp-action="Index">Phân quyền</a></li>
                        }
                    </ul>
                </div>
                <div class="navbar-end gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="hidden max-w-40 truncate text-sm text-base-content/70 sm:inline" title="@User.Identity.Name">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="false" class="hidden sm:block">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="/" />
                            <button type="submit" class="btn btn-outline btn-sm">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm hidden sm:inline-flex" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    }
                    <div class="dropdown dropdown-end md:hidden">
                        <button class="btn btn-ghost btn-square" type="button" aria-label="Mở menu" aria-haspopup="true">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </button>
                        <ul class="menu dropdown-content z-30 mt-3 w-52 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                            <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a></li>
                            @if (canReadRoles)
                            {
                                <li><a asp-controller="Roles" asp-action="Index">Vai trò</a></li>
                            }
                            @if (canReadUsers)
                            {
                                <li><a asp-controller="Users" asp-action="Index">Người dùng</a></li>
                            }
                            @if (canReadPermissions)
                            {
                                <li><a asp-controller="Permissions" asp-action="Index">Phân quyền</a></li>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="false">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="/" />
                                        <button type="submit">Đăng xuất</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main id="main-content" class="mx-auto w-full max-w-7xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
            @RenderBody()
        </main>

        <footer class="border-t border-base-300 bg-base-100">
            <div class="mx-auto flex w-full max-w-7xl flex-col gap-2 px-4 py-6 text-sm text-base-content/70 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
                <p>&copy; @DateTime.Now.Year BaseMVC. Nền tảng khởi đầu cho ứng dụng của bạn.</p>
                <a class="link link-hover" asp-area="" asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
