{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=basemvc.db"
  },
  "SqliteBackup": {
    "Enabled": true,
    "Directory": "App_Data/Backups",
    "IntervalHours": 24,
    "RetentionDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
